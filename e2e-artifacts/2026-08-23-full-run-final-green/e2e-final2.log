[WebServer]     query: "\n      SELECT COUNT(*) AS count FROM (\n        -- yarn / legacy beam receipts via jw_challans_in\n        SELECT ji.id, 'challan_in' AS tx_type\n        FROM jw_challans_in ji\n        WHERE ji.challan_out_id = $1::uuid\n          AND EXISTS (\n            SELECT 1 FROM stock_ledger sl\n            WHERE sl.transaction_type = 'challan_in'\n              AND sl.transaction_id = ji.id\n              AND sl.notes IS NULL\n          )\n          AND NOT EXISTS (\n            SELECT 1 FROM stock_ledger sl\n            WHERE sl.transaction_type = 'challan_in'\n              AND sl.transaction_id = ji.id\n              AND sl.notes = 'cancellation'\n          )\n        UNION ALL\n        -- sizing beam receipts via beam_receipts (B-010). Header challan_out_id\n        -- was dropped (M2, design v2 mixed-challan) — a receipt is \"against\" this\n        -- OUT challan when ANY of its items derives from one of its out-items.\n        SELECT br.id, 'beam_receipt' AS tx_type\n        FROM beam_receipts br\n        WHERE EXISTS (\n            SELECT 1 FROM beam_receipt_items bri\n            JOIN jw_challan_out_items oi ON oi.id = bri.out_item_id\n            WHERE bri.beam_receipt_id = br.id\n              AND oi.challan_out_id = $2::uuid\n          )\n          AND EXISTS (\n            SELECT 1 FROM stock_ledger sl\n            WHERE sl.transaction_type = 'beam_receipt'\n              AND sl.transaction_id = br.id\n              AND sl.notes IS NULL\n          )\n          AND NOT EXISTS (\n            SELECT 1 FROM stock_ledger sl\n            WHERE sl.transaction_type = 'beam_receipt'\n              AND sl.transaction_id = br.id\n              AND sl.notes = 'cancellation'\n          )\n        UNION ALL\n        -- weaving-in receipts (WI-L14) — a receipt is \"against\" this OUT\n        -- challan when ANY of its weft sources derives from one of its items.\n        SELECT wi.id, 'weaving_in' AS tx_type\n        FROM weaving_ins wi\n        WHERE EXISTS (\n            SELECT 1 FROM weaving_in_weft_sources wiws\n            JOIN jw_challan_out_items oi ON oi.id = wiws.out_item_id\n            WHERE wiws.weaving_in_id = wi.id\n              AND oi.challan_out_id = $3::uuid\n          )\n          AND EXISTS (\n            SELECT 1 FROM stock_ledger sl\n            WHERE sl.transaction_type = 'weaving_in'\n              AND sl.transaction_id = wi.id\n              AND sl.notes IS NULL\n          )\n          AND NOT EXISTS (\n            SELECT 1 FROM stock_ledger sl\n            WHERE sl.transaction_type = 'weaving_in'\n              AND sl.transaction_id = wi.id\n              AND sl.notes = 'cancellation'\n          )\n      ) AS active\n    "
